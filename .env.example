# Shared API key for OpenAI-compatible and Anthropic Messages gateways.
API_KEY=sk-...

# OpenAI Chat Completions compatible base (no trailing path).
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Messages compatible base (provider appends /v1/messages).
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional model overrides for live tests / demo.
# LIVE_MODEL=gpt-4o-mini
# LIVE_OPENAI_MODEL=gpt-4o-mini
# LIVE_ANTHROPIC_MODEL=claude-sonnet-4-20250514
